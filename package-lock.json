{
  "name": "hqpl-sdk",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "hqpl-sdk",
      "workspaces": [
        "telemetry",
        "telemetry-sourcemaps"
      ]
    },
    "node_modules/@hqpl/qtpack": {
      "resolved": "telemetry-sourcemaps",
      "link": true
    },
    "node_modules/@hqpl/telemetry": {
      "resolved": "telemetry",
      "link": true
    },
    "telemetry": {
      "name": "@hqpl/telemetry",
      "version": "0.2.3",
      "license": "MIT",
      "engines": {
        "node": ">=18"
      },
      "peerDependencies": {
        "@react-native-async-storage/async-storage": ">=1.17",
        "@react-native-community/netinfo": ">=9",
        "expo-router": ">=3",
        "react": ">=18",
        "react-native": ">=0.72"
      },
      "peerDependenciesMeta": {
        "@react-native-async-storage/async-storage": {
          "optional": true
        },
        "@react-native-community/netinfo": {
          "optional": true
        },
        "expo-router": {
          "optional": true
        },
        "react": {
          "optional": true
        },
        "react-native": {
          "optional": true
        }
      }
    },
    "telemetry-sourcemaps": {
      "name": "@hqpl/qtpack",
      "version": "0.4.6",
      "license": "MIT",
      "bin": {
        "qtpack": "bin/qtpack.js"
      },
      "engines": {
        "node": ">=18"
      },
      "peerDependencies": {
        "vite": ">=5"
      },
      "peerDependenciesMeta": {
        "vite": {
          "optional": true
        }
      }
    }
  }
}
