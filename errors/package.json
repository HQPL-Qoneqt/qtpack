{
  "name": "@hqpl/errors",
  "version": "0.1.0",
  "description": "Error tracking only, for Hqpl web (React) and React Native apps: uncaught errors, unhandled rejections, failed requests and render errors. Stack traces resolve server-side via @hqpl/qtpack sourcemaps.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.js",
  "react-native": "./src/index.native.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "react-native": "./src/index.native.js",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "react.js",
    "react.d.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=16.8",
    "react-native": ">=0.70"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  }
}
